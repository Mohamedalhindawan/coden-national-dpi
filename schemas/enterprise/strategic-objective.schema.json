{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coden.it.com/schemas/enterprise/strategic-objective.schema.json",
  "title": "CODEN Strategic Objective",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective_id",
    "portfolio_id",
    "title",
    "owner_id",
    "status",
    "created_at"
  ],
  "properties": {
    "objective_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "initiative_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "owner_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "active",
        "at_risk",
        "on_hold",
        "achieved",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    }
  }
}
