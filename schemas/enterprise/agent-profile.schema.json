{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coden.it.com/schemas/enterprise/coden-agent-profile.schema.json",
  "title": "CODEN Agent Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "display_name",
    "agent_type",
    "profile_version",
    "status",
    "risk_tier",
    "created_at"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "agent_type": {
      "enum": [
        "coding",
        "research",
        "qa",
        "security",
        "operations",
        "orchestration",
        "other"
      ]
    },
    "provider_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "model_id": {
      "type": "string",
      "maxLength": 160
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "suspended",
        "retired"
      ]
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "skill_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "human_owner_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    }
  }
}
