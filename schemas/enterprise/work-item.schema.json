{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coden.it.com/schemas/enterprise/coden-work-item.schema.json",
  "title": "CODEN Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_item_id",
    "project_id",
    "title",
    "owner_principal_id",
    "priority",
    "status",
    "acceptance_criteria",
    "data_class",
    "allowed_tools",
    "created_at"
  ],
  "properties": {
    "work_item_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "maxLength": 8000
    },
    "owner_principal_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "assignee_agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "ready",
        "in_progress",
        "validating",
        "human_review",
        "accepted",
        "blocked",
        "rejected",
        "cancelled",
        "failed"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "data_class": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "synthetic"
      ]
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "budget_limit": {
      "type": "number",
      "minimum": 0
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
