{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coden.it.com/schemas/enterprise/portfolio.schema.json",
  "title": "CODEN Enterprise Portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "portfolio_id",
    "name",
    "owner_id",
    "status",
    "budget_amount",
    "currency",
    "created_at"
  ],
  "properties": {
    "portfolio_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "owner_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "on_hold",
        "completed",
        "cancelled"
      ]
    },
    "budget_amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
