{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coden.it.com/schemas/enterprise/coden-project.schema.json",
  "title": "CODEN Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "name",
    "owner_principal_id",
    "status",
    "risk_tier",
    "data_class",
    "created_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "objective_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "owner_principal_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "active",
        "on_hold",
        "completed",
        "cancelled"
      ]
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "data_class": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "synthetic"
      ]
    },
    "budget_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
