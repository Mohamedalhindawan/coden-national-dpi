    "README.md": "# DEMO-DURATIONS\n\nThe program calculates the sum of a list of integer durations, or returns zero for an empty list.\n\nRun `python3 candidate.pyz < input.json`. Input and output use JSON.\n\nInput: `[]`\n\nExpected: `0`\n",
    "__main__.py": "from cli import main\nmain()\n",
    "cli.py": "import json\nimport sys\nfrom summary import transform\n\ndef main():\n    print(json.dumps(transform(json.load(sys.stdin)), allow_nan=False, separators=(\",\", \":\")))\n",
    "summary.py": "def transform(value):\n    return sum(value) if value else 0\n",
    "test_contract.py": "import unittest\nfrom summary import transform\n\nclass Contract(unittest.TestCase):\n    def test_0(self):\n        self.assertEqual(transform([]), 0)\n    def test_1(self):\n        self.assertEqual(transform([3, 4]), 7)\n    def test_2(self):\n        self.assertEqual(transform([4, 3]), 7)\n"
