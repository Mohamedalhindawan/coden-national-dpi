{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coden.example/schemas/task.schema.json",
  "title": "CODEN Agent Task Contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "task_id",
    "role_id",
    "owner",
    "objective",
    "inputs",
    "constraints",
    "acceptance_criteria",
    "deadline",
    "status"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1
    },
    "role_id": {
      "enum": [
        "ORC-01",
        "PLN-01",
        "ARC-01",
        "DPI-01",
        "DEV-01",
        "DATA-01",
        "SEC-01",
        "QA-01",
        "DOC-01",
        "FIN-01",
        "REL-01"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "uri",
          "classification"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "pattern": "^workspace://"
          },
          "classification": {
            "enum": [
              "synthetic",
              "public",
              "internal",
              "confidential",
              "personal",
              "sensitive"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_tools",
        "network",
        "write_scope",
        "max_runtime_seconds",
        "max_retries"
      ],
      "properties": {
        "allowed_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "network": {
          "enum": [
            "disabled",
            "allowlisted"
          ]
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^workspace://"
          }
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ready",
        "in_progress",
        "blocked",
        "failed",
        "cancelled"
      ]
    }
  }
}
